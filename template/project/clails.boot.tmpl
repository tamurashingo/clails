; -*- mode: lisp -*-
;;;; boot from clails cli

(let* ((clails-home (uiop:getenv "CLAILS_HOME"))
       (project-dir (if clails-home
                        (uiop:ensure-directory-pathname clails-home)
                        (uiop/os:getcwd))))
  (push project-dir asdf:*central-registry*)
  (ql:quickload :<%= (@ project-name ) %>)
  (setf clails/environment:*project-dir* project-dir)
  (setf clails/environment:*migration-base-dir* clails/environment:*project-dir*)
  (setf clails/environment:*task-base-dir* clails/environment:*project-dir*))

;;; This clails.boot was generated by clails <%= (asdf:component-version (asdf:find-system :clails)) %>.
;;; clails.boot is a per-project file: it is generated once by `clails new` and is not
;;; automatically updated when the framework changes. Warn (without aborting) when this
;;; project's boot script was generated by a different clails version than the one
;;; currently installed, since the boot sequence itself may have drifted since then.
(clails/environment:warn-if-framework-version-mismatch "<%= (asdf:component-version (asdf:find-system :clails)) %>")

(let ((envname (uiop:getenv "CLAILS_ENV")))
  (when envname
    (clails/environment:set-environment envname)))

(<%= (@ project-name) %>/config/database:initialize-database-config)
