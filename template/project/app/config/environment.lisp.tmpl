; -*- mode: lisp -*-
(in-package #:cl-user)
(defpackage #:<%= (@ project-name ) %>/config/environment
  (:use #:cl)
  (:import-from #:clails/environment
                #:*project-environment*
                #:*routing-tables*
                #:*strict-configuration*
                #:add-startup-hook
                #:add-shutdown-hook)
  ;; Session settings.  Every session option is declared in a session-specific
  ;; package and re-exported by clails/middleware/session-middleware, so one
  ;; package is enough to configure all of them.
  (:import-from #:clails/middleware/session-middleware
                #:*enable-session-middleware*
                #:*session-store*
                #:*session-state*
                #:*session-cookie-secure*
                #:*session-idle-timeout*
                #:*session-sweep-enabled*
                #:*session-sweep-interval*)
  ;; The CSRF verification stage.  A stage's own settings live in that stage's
  ;; package, which is why this is a package of its own rather than more
  ;; symbols from the session one.
  (:import-from #:clails/middleware/csrf-middleware
                #:*enable-csrf-middleware*
                #:*csrf-form-token*
                #:*csrf-header-name*
                #:*csrf-one-time-token*)
  ;; The request-method override stage, which lets a form reach a resource's
  ;; update / destroy routes.
  (:import-from #:clails/middleware/method-override-middleware
                #:*enable-method-override*
                #:*method-override-parameter*)
  (:export #:initialize-environment-config))

(in-package #:<%= (@ project-name ) %>/config/environment)

;; project name
(setf clails/environment:*project-name* "<%= (@ project-name ) %>")

;; project environment
(setf clails/environment:*project-environment* :develop)

(setf clails/environment:*routing-tables*
  '((:path "/"
     :controller "<%= (@ project-name )%>/controllers/application-controller:<application-controller>")))


;;; ------------------------------------------------------------------
;;; Sessions
;;; ------------------------------------------------------------------
;;;
;;; Sessions are enabled in a generated project, so (session controller) and
;;; (current-user controller) work from the first request.  The FRAMEWORK's own
;;; default is "disabled": a project whose configuration has no lines like the
;;; ones below keeps behaving exactly as it did, and the defaults written out
;;; here are this project's configuration rather than something clails decides
;;; on its own.
;;;
;;; All of these variables are read once, while the middleware stack is being
;;; built by `clails server'.  Changing them in a running image does not change
;;; how the running server answers.
;;;
;;; The guide is document/session.md in the clails source tree.

;; Enable clails' cookie session stage.
(setf *enable-session-middleware* t)

;; Where sessions are kept.  NIL means clails' own in-memory store: right for
;; development and for a single process, but the sessions are lost when the
;; process stops and are not shared with a second process.
;;
;; To keep them in the database instead -- the recommended production setup --
;; create the table once with `clails db:create-session-table' (it reads
;; db/session-table.lisp; see "Setup Database" in README.md) and point the store
;; at it:
;;
;;     (setf *session-store*
;;           (clails/middleware/session/store/db:make-db-session-store))
;;
;; A session kept in a table may only hold values that can be printed and read
;; back (strings, numbers, symbols, lists, vectors, hash-tables of those).
;; Class instances and streams have to be kept outside the session.
(setf *session-store* nil)

;; The cookie clails emits by default is
;;
;;     <name>=<id>; path=/; HttpOnly; SameSite=Lax
;;
;; HttpOnly (no script can read it), SameSite stated explicitly, a name that
;; does not advertise the implementation -- and deliberately NO expiry date.
;; The deadline is the server-side idle timeout below; a date on the cookie
;; would become an absolute deadline counted from the moment the session was
;; created, because a cookie is only re-sent when the session is created,
;; renamed or destroyed.
;;
;; Set *SESSION-STATE* to change the name, path, domain or SameSite:
;;
;;     (setf *session-state*
;;           (clails/middleware/session/state/cookie:make-clails-cookie-state
;;             :cookie-key "_<%= (@ project-name ) %>_session"
;;             :samesite :strict))

;; How long a session may stay UNUSED before it expires, in seconds.
;; Framework default: 1800 (30 minutes).  This is an idle time, not a lifetime:
;; every request carrying a live session pushes the deadline forward, so a user
;; who keeps working is never logged out.  NIL switches server-side expiry off
;; entirely.
(setf *session-idle-timeout* 1800)

;; Expired sessions are removed in two ways, and both are on: lazily, when an
;; expired session is presented, and by a background sweeper thread that the
;; server starts in a startup hook and stops in a shutdown hook.  Framework
;; defaults: sweeping enabled, every 300 seconds.  Setting the first to NIL
;; leaves cleanup to the lazy deletion alone -- correct, but it never frees a
;; session nobody comes back for.
(setf *session-sweep-enabled* t)
(setf *session-sweep-interval* 300)


;;; ------------------------------------------------------------------
;;; CSRF protection
;;; ------------------------------------------------------------------
;;;
;;; With this on, every state-changing request (POST / PUT / PATCH / DELETE)
;;; has to carry this session's CSRF token, and one that does not is answered
;;; with a 403 recorded on the :audit logger.  GET and HEAD are never verified.
;;;
;;; The session stage above MUST stay enabled: the token lives in the session.
;;; A configuration that enables this stage without it cannot serve a single
;;; state-changing request, and is refused while the stack is being built (see
;;; *STRICT-CONFIGURATION* below).
;;;
;;; Every form therefore needs the token in a hidden field.  Do not write that
;;; field by hand: call FORM-TAG / END-FORM-TAG (or FORM-WITH) from the
;;; template, which write it -- together with the hidden "_method" field when
;;; the form means PUT, PATCH or DELETE.  A generated view package already
;;; imports those helpers, so a template can call them unqualified; the worked
;;; examples are in the "Form helpers" section of document/view.md.
;;;
;;; A fetch/XHR request that cannot carry a body field may send the token in
;;; the X-CSRF-Token header instead.  The token is NOT read from the query
;;; string or from inside a JSON body.
;;;
;;; The framework's own default is NIL, so an existing project is unaffected
;;; until this line is added to its configuration.  See the "CSRF protection"
;;; section of document/session.md in the clails source tree.
(setf *enable-csrf-middleware* t)

;; The names the token may arrive under.  Shown rather than left implicit
;; because the hidden field the form helper renders and the header a
;; JavaScript caller sets both have to match them.
(setf *csrf-form-token* "_csrf_token")
(setf *csrf-header-name* "X-CSRF-Token")

;; NIL (the framework default) keeps one token for the whole session, so every
;; form on every page of that session carries the same one.  T makes a token
;; single-use: the request that verifies successfully removes it, so a replay
;; is refused -- and so are the back button, a double-clicked submit button, a
;; naive retry, and every other form left open on the page.  Read "One-time
;; tokens: what they cost" in document/session.md before switching it on.
(setf *csrf-one-time-token* nil)


;;; ------------------------------------------------------------------
;;; Request-method override (the "_method" hidden field)
;;; ------------------------------------------------------------------
;;;
;;; An HTML form can only be sent with GET or POST, so a form that means PUT,
;;; PATCH or DELETE says so in a hidden "_method" field and this stage
;;; rewrites the request method before the route is matched.  That is what
;;; lets a plain form reach the update and destroy routes of a resource.
;;;
;;; This one is ENABLED BY DEFAULT in the framework -- unlike the session and
;;; CSRF stages -- because it changes a request only when the request itself
;;; carries the field, which is that field's documented purpose.  There is no
;;; line to add to switch it on; the line below is how to switch it OFF:
;;;
;;;     (setf *enable-method-override* nil)
;;;
;;; The one reason to do that: a HAND-WRITTEN routing table that declares both
;;; a POST route and a PUT / PATCH / DELETE route on the SAME path.  Such a
;;; POST used to reach the POST route and now reaches the other one.  Tables
;;; built with (resources ...) are unaffected.
;;;
;;; Safety properties this stage keeps, and that are worth not working around:
;;; only a POST is rewritten, only into PUT / PATCH / DELETE (never into a
;;; method that would be exempt from CSRF verification), the value is read from
;;; the request BODY only (never from the query string, or a link could delete
;;; something), an unknown value leaves the method alone, and the stage runs
;;; INSIDE CSRF verification so a forged method is never honoured before the
;;; token has been checked.
;;;
;;; The field's name, should something generating your forms insist on another:
(setf *method-override-parameter* "_method")


;;; ------------------------------------------------------------------
;;; The two settings that differ per environment
;;; ------------------------------------------------------------------
;;;
;;; clails never inspects which environment it is running in -- it only reads
;;; these variables -- so the environment difference lives in this file.
;;;
;;; Secure cookie (*SESSION-COOKIE-SECURE*)
;;; ---------------------------------------
;;; T means the browser sends the session cookie over HTTPS ONLY.  The
;;; framework default is NIL, which is a deliberate exception to "default to
;;; the safe value": a Secure cookie is not sent over plain HTTP AT ALL, so
;;; turning it on in a development or test environment that runs without TLS
;;; stops sessions from working altogether -- the cookie is set and never comes
;;; back, so every request looks like a first visit.  Production is served over
;;; HTTPS, so it is turned on there.
;;;
;;; Strict configuration (*STRICT-CONFIGURATION*)
;;; ---------------------------------------------
;;; What happens when clails finds a configuration that cannot work.  T aborts:
;;; the startup check refuses to build a stack whose CSRF stage is enabled
;;; without the session stage, and a request whose stage order is broken (the
;;; override stage running outside CSRF verification) is answered with a 403.
;;; NIL records a warning on the :audit logger -- once per process for the
;;; stage-order check -- and carries on serving.
;;;
;;; The framework default is T, and this file is what puts NIL in development
;;; and test.  Careful with NIL: a broken stage order then opens the
;;; "_method=GET and no token" bypass SILENTLY, and the one warning that says
;;; so is easy to miss.
;;;
;;; Why the two defaults point in OPPOSITE directions
;;; -------------------------------------------------
;;; *STRICT-CONFIGURATION* defaults to the safe value (T) and
;;; *SESSION-COOKIE-SECURE* defaults to the unsafe one (NIL), which looks
;;; inconsistent and is not:
;;;
;;;   * a safe default for strict breaks NOTHING that was working.  It only
;;;     fires on a configuration that cannot serve a request anyway, so the
;;;     worst it costs is an early, explicit failure instead of a late,
;;;     mysterious one;
;;;   * a safe default for Secure breaks EVERY development environment, which
;;;     is served over plain HTTP.  Sessions would simply stop working, with
;;;     no error anywhere, until someone found this variable.
;;;
;;; So each default is chosen by what it costs when it is wrong, and the
;;; convenience the other direction would have given is handed out here, per
;;; environment, instead.

(defun setup-environment/develop ()
  ;; served over plain HTTP: Secure would break the session
  (setf *session-cookie-secure* nil)
  ;; report a broken configuration, but keep serving
  (setf *strict-configuration* nil))

(defun setup-environment/test ()
  ;; served over plain HTTP, same as development
  (setf *session-cookie-secure* nil)
  ;; a failing check must not abort a test run
  (setf *strict-configuration* nil))

(defun setup-environment/production ()
  ;; served over HTTPS: send the session cookie over TLS only
  (setf *session-cookie-secure* t)
  ;; refuse to come up, or to answer, in a configuration that cannot work
  (setf *strict-configuration* t))

(defun initialize-environment-config (&optional environment)
  "Apply the settings that depend on the environment.

   Today those are the Secure flag of the session cookie and the strictness of
   the configuration checks; anything else that has to differ between
   development, test and production belongs in the same three functions, so
   that clails.boot keeps one call.

   If environment is not specified, it will be obtained from
   clails/environment:*project-environment*.

   Called from clails.boot, after CLAILS_ENV has been resolved and before the
   middleware stack is built -- not from a startup hook, because the stack (and
   with it the session cookie and the CSRF configuration check) is built before
   the startup hooks run.

   Supported environments:
   - :develop, :development - Development environment
   - :test - Test environment
   - :production - Production environment

   @param environment [keyword] Environment keyword (optional)
   @return [null] nil
   @condition error Unknown environment specified
   "
  (let ((env (or environment *project-environment*)))
    (case env
      ((:develop :development) (setup-environment/develop))
      (:test (setup-environment/test))
      (:production (setup-environment/production))
      (t (error "Unknown environment: ~A" env)))
    nil))


;; startup hooks (run in registration order, after the framework's own default hooks)
(add-startup-hook "<%= (@ project-name) %>/config/logger:initialize-logger")
(add-startup-hook "clails/model/base-model:initialize-table-information")

;; shutdown hooks (run in registration order, after the framework's own default hooks)
(add-shutdown-hook "<%= (@ project-name) %>/config/logger:finalize-logger")
