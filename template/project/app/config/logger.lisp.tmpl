; -*- mode: lisp -*-
(in-package #:cl-user)
(defpackage #:<%= (@ project-name ) %>/config/logger
  (:use #:cl)
  (:import-from #:clails/logger
                #:clear-loggers
                #:register-logger
                #:make-console-appender
                #:make-file-appender
                #:close-appender
                #:<text-formatter>
                #:<json-formatter>)
  (:export #:initialize-logger
           #:finalize-logger))

(in-package #:<%= (@ project-name ) %>/config/logger)

(defun setup-logger/develop ()
  (clear-loggers)

  (ensure-directories-exist "logs/")

  ;; project default logger
  (register-logger
   :root
   :appenders (list (make-console-appender
                     :formatter (make-instance '<text-formatter>))
                    (make-file-appender
                     :filepath "logs/application.develop.log"
                     :formatter (make-instance '<text-formatter>)))
   :level :debug)

  ;; clails framework logger
  (register-logger
   :clails
   :appender (make-console-appender
              :formatter (make-instance '<text-formatter>))
   :level :error)

  ;; SQL logger
  (register-logger
   :sql
   :appender (make-console-appender
              :formatter (make-instance '<text-formatter>))
   :level :debug)

  ;; web-access logger
  (register-logger
   :web-access
   :appender (make-console-appender
              :formatter (make-instance '<text-formatter>))
   :level :info)

  ;; audit logger
  (register-logger
   :audit
   :appender (make-console-appender
              :formatter (make-instance '<text-formatter>))
   :level :info)

  ;; task logger
  (register-logger
   :task
   :appender (make-console-appender
              :formatter (make-instance '<text-formatter>))
   :level :info)

  ;; background job logger
  ;;
  ;; clails/logger/core:log.job writes at :info, so :info is the lowest level
  ;; that lets a job record through.  Registered in every environment: without a
  ;; registration of its own, :job falls through the name hierarchy onto the
  ;; project default, where it either mixes in with everything else or is
  ;; dropped outright.
  (register-logger
   :job
   :appender (make-console-appender
              :formatter (make-instance '<text-formatter>))
   :level :info)

  nil)


