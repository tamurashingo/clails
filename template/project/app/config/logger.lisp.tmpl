  nil)



(defun setup-logger/production ()
  (clear-loggers)

  (ensure-directories-exist "logs/")

  ;; project default logger
  ;;
  ;; Registering a name twice replaces the first registration, so there is
  ;; exactly one :root logger here on purpose.
  (register-logger
   :root
   :appenders (list (make-console-appender
                     :formatter (make-instance '<json-formatter>))
                    (make-file-appender
                     :filepath "logs/application.log"
                     :formatter (make-instance '<json-formatter>)))
   :level :warn)

  ;; clails framework logger
  ;;
  ;; Deliberately not registered in production: a logger with no registration
  ;; of its own is looked up through the name hierarchy, so :clails records end
  ;; up on :root above -- which means framework warnings reach
  ;; logs/application.log instead of being dropped, as they would be with the
  ;; :error level the other two environments use.

  ;; SQL logger
  ;;
  ;; Declared with NO destination and at :none on purpose.  Production does not
  ;; emit debug records, and clails/logger:log.sql writes at :debug and only at
  ;; :debug -- so SQL never reaches a log here, which is the policy and not a
  ;; bug.  What WAS a problem is declaring a file that is guaranteed to stay
  ;; empty, so the file appender is gone and the level says plainly that
  ;; nothing passes.
  ;;
  ;; The registration itself is kept rather than deleted, for two reasons: it
  ;; is the single place to change when the policy changes, and leaving :sql
  ;; unregistered would instead route SQL records through the name hierarchy
  ;; onto :root, where the intent would no longer be readable.
  (register-logger
   :sql
   :level :none)

  ;; web-access logger
  (register-logger
   :web-access
   :appender (make-file-appender
              :filepath "logs/access.log"
              :formatter (make-instance '<json-formatter>))
   :level :info)

  ;; audit logger
  (register-logger
   :audit
   :appender (make-file-appender
              :filepath "logs/audit.log"
              :formatter (make-instance '<json-formatter>))
   :level :info)

  ;; task logger
  (register-logger
   :task
   :appender (make-file-appender
              :filepath "logs/task.log"
              :formatter (make-instance '<json-formatter>))
   :level :info)

  ;; background job logger
  ;;
  ;; Its own file rather than sharing logs/task.log: a scheduled task and a
  ;; queued job fail, retry and are retained differently, and one destination
  ;; per logger is what keeps "which file does this record go to" answerable
  ;; from this file alone.
  (register-logger
   :job
   :appender (make-file-appender
              :filepath "logs/job.log"
              :formatter (make-instance '<json-formatter>))
   :level :info)

  nil)


(defun initialize-logger (&optional environment)
  "Initialize the logging system according to the environment.

   If environment is not specified, it will be obtained from
   clails/environment:*project-environment*.

   Supported environments:
   - :develop, :development - Development environment
   - :test - Test environment
   - :production - Production environment

   @param environment [keyword] Environment keyword (optional)
   @return [null] nil
   @condition error Unknown environment specified
   "
  (let ((env (or environment
                 (and (find-package :clails/environment)
                      (symbol-value (find-symbol "*PROJECT-ENVIRONMENT*" :clails/environment)))
                 :develop)))
    (case env
      ((:develop :development) (setup-logger/develop))
      (:test (setup-logger/test))
      (:production (setup-logger/production))
      (t (error "Unknown environment: ~A" env)))))

(defun finalize-logger ()
  (maphash #'(lambda (k logger)
               (declare (ignore k))
               (let ((appenders (clails/logger/core::logger-appenders logger)))
                 (dolist (appender appenders)
                   (close-appender appender))))
           clails/logger/core::*logger-registry*))

